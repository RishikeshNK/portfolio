---
import "../styles/global.css";
import { NAME, WRITING_ENABLED } from "../constants";

interface Props {
  title?: string;
  description?: string;
  publishedAt?: Date;
}
const {
  title,
  description = `${NAME} is a Software Engineer at Rilla, building the most fun way to get better at sales. He studied Computer Science and Mathematics at Northeastern University.`,
  publishedAt,
} = Astro.props;
const fullTitle = title ? `${title} · ${NAME}` : NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="author" content={NAME} />
    <meta property="og:type" content={publishedAt ? "article" : "website"} />
    {
      publishedAt && (
        <>
          <meta property="article:author" content={NAME} />
          <meta property="article:published_time" content={publishedAt.toISOString()} />
          <meta name="publish_date" property="og:publish_date" content={publishedAt.toISOString()} />
        </>
      )
    }
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {WRITING_ENABLED && <link rel="alternate" type="application/rss+xml" title={NAME} href="/rss.xml" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
