---
import Base from "../layouts/Base.astro";
import { LINKS, NAME, WRITING_ENABLED } from "../constants";
---

<Base>
  <h1>{NAME}</h1>

  <p>
    Hi, I'm Rishi. I'm a Software Engineer at <a href={LINKS.rilla} target="_blank" rel="noopener">Rilla</a
    >, where we're building the most fun way to get better at sales. I studied Computer Science and Mathematics at Northeastern University in Boston.
  </p>

  {WRITING_ENABLED && <p>I also <a href="/writing">write</a> sometimes.</p>}

  <hr />

  <footer>
    <a href={`mailto:${LINKS.email}`}>rishi [at] kanabar [dot] dev</a> &nbsp;&middot;&nbsp;
    <a href={LINKS.github} target="_blank" rel="noopener">GitHub</a> &nbsp;&middot;&nbsp;
    <a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a>
  </footer>
</Base>
