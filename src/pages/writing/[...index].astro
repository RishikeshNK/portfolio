---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { WRITING_ENABLED } from "../../constants";
import { formatDate, readingTime } from "../../format";

export function getStaticPaths() {
  return WRITING_ENABLED ? [{ params: { index: undefined } }] : [];
}

const posts = (await getCollection("writing", (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Writing · Rishi Kanabar">
  <h1>Writing</h1>

  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}`}>{post.data.title}</a>
          <span class="muted">{formatDate(post.data.date)} · {readingTime(post.body)}</span>
          {post.data.description && <p class="muted">{post.data.description}</p>}
        </li>
      ))
    }
  </ul>

  <hr />

  <footer><a href="/">Home</a></footer>
</Base>
