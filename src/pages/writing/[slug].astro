---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { NAME } from "../../constants";
import { formatDate, readingTime } from "../../format";
import { getPosts } from "../../posts";

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} publishedAt={post.data.date}>
  <a class="masthead" href="/">{NAME}</a>
  <h1>{post.data.title}</h1>
  <p class="muted">{formatDate(post.data.date, "long")} · {readingTime(post.body)}</p>

  <div class="post">
    <Content />
  </div>

  <hr />

  <footer><a href="/writing">More writing</a></footer>
</Base>
