---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { WRITING_ENABLED } from "../../constants";
import { formatDate, readingTime } from "../../format";

export async function getStaticPaths() {
  if (!WRITING_ENABLED) return [];
  const posts = await getCollection("writing", (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} · Rishi Kanabar`} description={post.data.description}>
  <h1>{post.data.title}</h1>
  <p class="muted">{formatDate(post.data.date, "long")} · {readingTime(post.body)}</p>

  <Content />

  <hr />

  <footer><a href="/writing">More writing</a></footer>
</Base>
